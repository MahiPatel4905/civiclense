# Copy this file to  .env  and fill in the real values.
# Never share or upload the real .env - it holds your database password.

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@yourcluster.mongodb.net/
SECRET_KEY=put_a_long_random_string_here

# ----------------------------------------------------------
# Vision fallback - a second opinion when best.pt is unsure
# ----------------------------------------------------------
# best.pt is unreliable on most categories (measured on real
# photos: it often names the wrong issue with high confidence),
# so by default EVERY upload gets a second opinion from this
# model. If it says "no civic issue", best.pt's claim is dropped
# and a person decides. If it is unreachable, best.pt's answer
# still routes but is always flagged "unverified".
#
# Leave VISION_FALLBACK=off, or leave the key blank, and the
# backend behaves as before: YOLO only.
#
# Free key (1 minute, no card):  https://aistudio.google.com/apikey

VISION_FALLBACK=on
VISION_PROVIDER=gemini
GEMINI_API_KEY=

# Optional - Groq instead of Google (fast, free key at
# https://console.groq.com/keys). Default model qwen/qwen3.8-27b:
# VISION_PROVIDER=groq
# GROQ_API_KEY=

# Optional - only if you prefer OpenRouter over Google:
# VISION_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Optional - override the model. Default is gemini-3.5-flash-lite;
# if it is retired or out of free quota the next one in
# vision_fallback.py's rotation is tried automatically.
# VISION_MODEL=gemini-3.5-flash-lite

# Optional - categories best.pt may be trusted on WITHOUT a second
# opinion (saves API quota). Empty = check everything. Pothole was
# the only class that measured well, but it still produced false
# alarms, so widen this only after retraining and re-measuring.
# AI_TRUSTED_CATEGORIES=pothole
